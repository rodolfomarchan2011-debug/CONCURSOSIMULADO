# Copie para .env.local e preencha o que for usar.
# Sem nenhuma chave, o tutor funciona em modo offline (base local).

# Provedor compatível com OpenAI (recomendado: OpenAI, DeepSeek ou OpenRouter)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Alternativa DeepSeek
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Alternativa OpenRouter
OPENROUTER_API_KEY=

# Busca na web para dúvidas (opcional)
TAVILY_API_KEY=
