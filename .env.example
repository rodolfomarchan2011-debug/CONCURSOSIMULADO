# Copie para .env.local e escolha UMA opção. Sem nenhuma chave, o tutor
# funciona em modo offline (base local, sem inventar).

# ---------------------------------------------------------------------------
# Opção 1 (grátis, local): Ollama na própria máquina.
# Instale em https://ollama.com e baixe um modelo: ollama pull qwen2.5:7b
# ---------------------------------------------------------------------------
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5:3b-instruct
AI_MAX_TOKENS=400
AI_PROVEDOR_NOME=ollama-local

# ---------------------------------------------------------------------------
# Opção 2 (grátis com cota): Google Gemini (AI Studio) — rápido e bom em texto.
# Chave: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# AI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Opção 3 (grátis com cota): Groq — modelos abertos, muito rápido.
# Chave: https://console.groq.com/keys
# ---------------------------------------------------------------------------
# GROQ_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Opção 4 (grátis com cota): OpenRouter — alguns modelos ":free".
# Chave: https://openrouter.ai/keys
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# AI_MODEL=deepseek/deepseek-chat-v3-0324:free

# ---------------------------------------------------------------------------
# Opção 5 (pago, barato): DeepSeek API.
# Chave: https://platform.deepseek.com
# ---------------------------------------------------------------------------
# DEEPSEEK_API_KEY=
# AI_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Opção 6 (pago): OpenAI
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini

# Busca na web para dúvidas (opcional, gratuita até a cota do Tavily)
# TAVILY_API_KEY=
